# Environment
ENVIRONMENT=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000
DEBUG_AI=false

# Registered Store Owner Phone Number (WhatsApp E.164 without leading +)
OWNER_PHONE_NUMBER=919608147859

# Meta Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=1134010659806490
WHATSAPP_VERIFY_TOKEN=vyapar_ai_secret_verify_token
WHATSAPP_APP_SECRET=

# Database Credentials
POSTGRES_USER=vyapar
POSTGRES_PASSWORD=vyapar_pass
POSTGRES_DB=vyapar_db
DATABASE_URL=postgresql+asyncpg://vyapar:vyapar_pass@postgres:5432/vyapar_db
SYNC_DATABASE_URL=postgresql+psycopg2://vyapar:vyapar_pass@postgres:5432/vyapar_db

# OpenRouter LLM Provider
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# Groq Ultra-Fast Provider
GROQ_API_KEY=your_groq_api_key_here

# Upstash Redis (Temporary Conversation State & Idempotency ONLY)
UPSTASH_REDIS_REST_URL=https://light-stork-133652.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
